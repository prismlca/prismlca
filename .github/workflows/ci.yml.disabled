name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  build:
    name: Build & test (${{ matrix.os }})
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      # ---- Backend: test + PyInstaller bundle ----
      - name: Install uv
        uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0

      - name: Backend deps
        working-directory: backend
        run: uv sync --extra dev --extra build

      - name: Backend lint (ruff)
        working-directory: backend
        run: uv run ruff check .

      - name: Backend tests
        working-directory: backend
        run: uv run pytest -q

      - name: Backend bundle (PyInstaller onedir)
        working-directory: backend
        run: uv run pyinstaller prism_backend.spec --noconfirm

      # ---- Frontend: build + installer (bundles the backend via extraResources) ----
      - name: Setup Node
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22

      - name: Frontend deps
        working-directory: frontend
        run: npm install

      - name: Typecheck
        working-directory: frontend
        run: npm run typecheck

      # `lint` runs `prettier --check` first, so a formatting drift fails here too. Kept as one
      # step rather than two: it is the same command the local routine runs, and a gate that
      # differs from the one people actually use is a gate nobody trusts.
      - name: Frontend format + lint (prettier, eslint)
        working-directory: frontend
        run: npm run lint

      - name: Frontend unit tests (vitest)
        working-directory: frontend
        run: npm test

      - name: Build installers
        working-directory: frontend
        run: npm run dist

      - name: Upload installers
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: prism-lca-${{ matrix.os }}
          path: |
            frontend/release/*.exe
            frontend/release/*.AppImage
            frontend/release/*.deb
          if-no-files-found: ignore
