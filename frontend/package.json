{
  "name": "prism-lca",
  "version": "0.9.3",
  "desktopName": "prism-lca.desktop",
  "description": "PrismLCA — modern desktop LCA software (Electron shell).",
  "author": {
    "name": "Jonas Harth",
    "email": "harthjonas@gmail.com"
  },
  "homepage": "https://github.com/prismlca/prismlca",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node -e \"require('electron')\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepreview": "node -e \"require('electron')\"",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "prettier --check src && eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --project node",
    "test:cov": "vitest run --coverage",
    "eval:live": "PRISM_EVAL_LIVE=1 vitest run src/main/ai/live-eval.test.ts",
    "eval:research": "PRISM_EVAL_LIVE=1 vitest run src/main/ai/research-eval.test.ts",
    "tools:manifest": "esbuild scripts/dump-tool-manifest.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/prism-tool-manifest.cjs --log-level=warning && node node_modules/.cache/prism-tool-manifest.cjs",
    "release": "node scripts/release/prepare.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "eval:match": "PRISM_MATCH_EVAL_LIVE=1 vitest run src/main/ai/import-match-eval.test.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xyflow/react": "^12.3.5",
    "ajv": "^8.20.0",
    "d3": "^7.9.0",
    "echarts": "^5.5.1",
    "electron-updater": "^6.8.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^44.10.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^2.3.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "3.6.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.9",
    "vitest": "^4.1.10"
  }
}
